APP_PORT=8082

# 엑셀 입력원: local 또는 google-drive
EXCEL_SOURCE=local
BULLETIN_EXCEL_PATH=/absolute/path/to/roster.xlsx
# Drive 사용 시 EXCEL_SOURCE=google-drive로 바꾸고 아래 값을 설정한다.
# GOOGLE_DRIVE_FILE_ID=drive-file-id
# GOOGLE_DRIVE_CREDENTIALS_PATH=/run/secrets/google-drive-service-account.json
# GOOGLE_DRIVE_CACHE_PATH=/data/active.xlsx
# GOOGLE_DRIVE_POLL_INTERVAL=PT5M

POSTGRES_DB=church_management
POSTGRES_USER=church
POSTGRES_PASSWORD=change-this-postgres-password

# 회원가입 허용 IP/CIDR
# 특정 PC 1대: 192.168.0.10/32
# 내부 대역: 192.168.0.0/24
SECURITY_SIGNUP_ALLOWED_NETWORK_1=127.0.0.1/32
SECURITY_SIGNUP_ALLOWED_NETWORK_2=0:0:0:0:0:0:0:1/128

# 이메일 인증 SMTP
# Gmail은 계정 비밀번호가 아니라 앱 비밀번호를 사용한다.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=change-this-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
SECURITY_MAIL_FROM=your-email@gmail.com

# 운영에서는 false 권장. 개발 중 SMTP 실패 시 인증 코드를 로그로 확인하려면 true.
SECURITY_EMAIL_VERIFICATION_LOG_CODE_WHEN_MAIL_FAILS=false
