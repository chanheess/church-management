#!/bin/sh
set -eu

commit_msg_file="$1"
first_line="$(head -n 1 "$commit_msg_file" | tr -d '\r')"

# 머지·리베이스 커밋은 허용
case "$first_line" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *)
    exit 0
    ;;
esac

# main 브랜치 커밋은 형식 검사 생략
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
if [ "$BRANCH" = "main" ]; then
  exit 0
fi

# 허용 형식: [#12] feat: 메시지
#             [#12] fix(scope): 메시지
pattern='^\[#([0-9]+)\][[:space:]]+(feat|fix|docs|style|refactor|test|chore)(\([^)]+\))?:[[:space:]]+.+'

if ! printf "%s" "$first_line" | grep -Eq "$pattern"; then
  echo ""
  echo "❌ 커밋 메시지 형식이 올바르지 않습니다."
  echo ""
  echo "  형식: [#이슈번호] type(scope): 한 줄 요약"
  echo ""
  echo "  type 목록: feat | fix | docs | style | refactor | test | chore"
  echo ""
  echo "  예시:"
  echo "    [#12] feat: 대표기도 순번 교체 기능 추가"
  echo "    [#8] fix(bulletin): 생일 날짜 계산 오류 수정"
  echo ""
  echo "  현재 입력: $first_line"
  echo ""
  exit 1
fi
